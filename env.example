APP_ENV=production
PORT=4173
TRUSTED_HOSTS=firmwarex.example.com
FIRMWAREX_SECRET_KEY=generate-a-random-secret-with-at-least-32-characters
FIRMWAREX_SETUP_TOKEN=generate-a-separate-random-token-with-at-least-32-characters
FIRMWAREX_DATABASE=/data/firmwarex.sqlite3
RATELIMIT_STORAGE_URI=redis://redis-host:6379/0
TRUST_PROXY=1